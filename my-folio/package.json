{
	"name": "my-folio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"prebuild": "node scripts/check-assets.mjs",
		"build": "vite build",
		"analyze": "ANALYZE=true vite build",
		"size": "npm run build && size-limit",
		"lint": "oxlint",
		"preview": "vite preview",
		"lhci:mobile": "lhci autorun",
		"lhci:desktop": "lhci autorun --collect.settings.preset=desktop"
	},
	"size-limit": [
		{
			"name": "vendor chunk",
			"path": [
				"dist/assets/vendor-*.js"
			],
			"limit": "80 kB",
			"gzip": true
		},
		{
			"name": "gsap chunk",
			"path": [
				"dist/assets/gsap-*.js"
			],
			"limit": "50 kB",
			"gzip": true
		},
		{
			"name": "motion chunk",
			"path": [
				"dist/assets/motion-*.js"
			],
			"limit": "50 kB",
			"gzip": true
		},
		{
			"name": "main JS",
			"path": [
				"dist/assets/index-*.js"
			],
			"limit": "30 kB",
			"gzip": true
		},
		{
			"name": "main CSS",
			"path": [
				"dist/assets/index-*.css"
			],
			"limit": "15 kB",
			"gzip": true
		}
	],
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/playfair-display": "^5.3.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"motion": "^12.43.0",
		"ogl": "^1.0.11",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0"
	},
	"devDependencies": {
		"@size-limit/file": "^13.1.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"jsrepo": "^3.8.1",
		"oxlint": "^1.79.0",
		"rollup-plugin-visualizer": "^7.1.1",
		"size-limit": "^13.1.1",
		"vite": "^8.2.2"
	}
}
